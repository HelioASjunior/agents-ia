{
  "name": "xinoia",
  "productName": "XinoIA",
  "version": "0.1.0",
  "description": "Escritório virtual local para orquestrar agentes de IA usando os CLIs oficiais e o login de cada usuário.",
  "type": "module",
  "private": true,
  "repository": "github:HelioASjunior/agents-ia",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "node --disable-warning=ExperimentalWarning --watch scripts/dev-server.ts",
    "doctor": "node --disable-warning=ExperimentalWarning apps/server/src/doctor.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test --test-force-exit --test-timeout=60000 \"apps/server/test/*.test.ts\"",
    "test:real": "node --disable-warning=ExperimentalWarning --test --test-force-exit --test-timeout=600000 --test-concurrency=1 \"apps/server/test/real/*.test.ts\"",
    "dev:web": "npm run dev --workspace @xinoia/web",
    "build:web": "npm run build --workspace @xinoia/web",
    "start": "node --disable-warning=ExperimentalWarning apps/server/src/index.ts",
    "build:desktop": "node scripts/build-desktop.mjs",
    "dist": "npm run build:desktop && npm exec --workspace xinoia -- electron-builder --config electron-builder.yml --publish never",
    "set-version": "node scripts/set-version.mjs",
    "build:icons": "electron scripts/build-icons.cjs",
    "start:desktop": "npm run build:desktop && npm start --workspace xinoia",
    "test:dist": "node scripts/test-installer.mjs",
    "verify": "node --disable-warning=ExperimentalWarning scripts/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "playwright-core": "1.64.1"
  }
}
